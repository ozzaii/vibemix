{
  "schema": "cue_real_corpus_v1",
  "source": "tests/bench/data/*.mp3 committed DJ audio fixtures",
  "detector": "vibemix.library.cue_detect.detect_cues",
  "min_label_recall": 1.0,
  "max_unexpected_labels": 0,
  "max_timing_misses": 0,
  "notes": [
    "This is a no-regression floor, not a public benchmark.",
    "Intro/outro labels are checked by presence only; dance labels also carry coarse timing windows.",
    "t1/t2 intentionally forbid dance labels so the detector cannot fabricate a drop on flatter clips."
  ],
  "tracks": [
    {
      "file": "t1_pyrez_darkside.mp3",
      "expected": [
        {"label": "intro"},
        {"label": "outro"}
      ]
    },
    {
