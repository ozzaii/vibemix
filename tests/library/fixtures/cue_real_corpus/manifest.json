      "expected": [
        {"label": "intro"},
        {"label": "breakdown", "start_min_s": 1.0, "start_max_s": 6.0},
        {"label": "drop", "start_min_s": 6.0, "start_max_s": 12.0},
        {"label": "outro"}
      ]
    },
    {
