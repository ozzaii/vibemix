// vibemix — Tauri 2.x app configuration (Phase 11 Wave 2)
//
// LOCKED VALUES (do NOT change after Phase 11):
//   - identifier: world.bravoh.vibemix  (D-Area-1 + entitlements.plist; permissions reset on change)
//   - bundle.resources: binaries/vibemix-core-<triple>/**/*  (PyInstaller onedir sidecar)
//   - app.windows[0]: 1440×900, native macOS decorations with overlay titlebar
//
// Phase 18 takes over signing/notarization with the hardenedRuntime + entitlements.plist.
// Tauri 2 supports JSON5 here (comments + trailing commas allowed).
{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vibemix",
  "version": "0.0.1",
  "identifier": "world.bravoh.vibemix",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    // tauri-cli has invoked beforeDevCommand from both `tauri/` and `tauri/ui/`
    // depending on launch path/version. Resolve the current cwd before picking
    // the npm command so `cargo tauri dev` does not double-prefix `ui/ui` or
    // walk upward to a nonexistent root package.json.
    "beforeDevCommand": "sh -c 'if [ -f ui/package.json ]; then npm --prefix ui run dev; else npm run dev; fi'",
    // Build the frontend and ensure the bundled PyInstaller sidecar is real
    // before Tauri packages resources. tauri-cli has invoked this command from
    // both `tauri/` and `tauri/ui/` depending on the launch path, so the shell
    // guard resolves the repo-root script from either cwd. Without this, a
    // direct local `cargo tauri build` can silently ship the committed
    // `.placeholder` sidecar directories, or a Chatterbox voice path with no
    // bundled production reference.
    "beforeBuildCommand": "sh -c 'if [ -f ../scripts/dist/prepare_tauri_build.py ]; then uv run python ../scripts/dist/prepare_tauri_build.py --require-chatterbox-ref; else cd ../.. && uv run python scripts/dist/prepare_tauri_build.py --require-chatterbox-ref; fi'"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "vibemix",
        // 2026-05-20 — the live session is a 3-column instrument; below the
        // 1100px CSS breakpoint it collapses to a single stacked column that
        // reads as broken. Open at 1440x900 (matches the design mock's
        // proportions) and never let the window drop below the breakpoint,
        // so the deck always renders as the wide 3-column layout. The wizard
        // (same window) is centered content and reads fine at this size.
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true,
        "decorations": true,
        // Transparent webview so the macOS NSVisualEffectView "Sidebar" vibrancy
        // (applied in main.rs setup) shows through the chrome + sidebar glass;
        // the opaque .shell-main content stage hides it. The shell body is only
        // transparent under #shell-root, so the wizard + other windows stay
        // solid. Windows uses Mica. See apply_main_native_material.
        "transparent": true,
        "fullscreen": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "center": true,
        // Keep the full app GUI available as the safe/default control surface.
        // The pill is an additional live overlay, not the only way to operate.
        "visible": true
      }
      // Phase 13 Plan 02 — the mascot overlay window is built at runtime
      // by `mascot_window::create_mascot_window` in main.rs .setup()
      // (transparent + always_on_top + skip_taskbar + visible_on_all_
      // workspaces, geometry from MascotWindowState). A static entry here
      // would collide with the runtime `WebviewWindowBuilder::new(app,
      // "mascot", ...)` call ("a webview with label `mascot` already
      // exists"). capabilities/default.json's `"windows": ["main", "mascot"]`
      // is the only place that needs to know the label — it's a
      // runtime command-scope allowlist, not a creation requirement.
    ],
    "security": {
      // CSP scope:
      //   - default-src 'self' — block external origins for everything not
      //     explicitly overridden.
      //   - script-src 'self' 'wasm-unsafe-eval' — Three.js DRACOLoader
      //     instantiates WASM (KHR_draco_mesh_compression on the mascot
      //     character GLB). Without 'wasm-unsafe-eval', WebAssembly.instantiate
      //     is blocked and the character mesh fails to load.
      //   - worker-src 'self' blob: — DRACOLoader spawns its decoder Worker
      //     via `new Worker(URL.createObjectURL(new Blob(...)))`. blob: must
      //     be allowed for the worker to be constructed.
      //   - connect-src 'self' ws://127.0.0.1:8765 — Plan 13-06 added the
      //     mascot webview's own WS subscription to the sidecar bus.
      //     'self' alone blocks ws://127.0.0.1:8765 (different origin).
      //   - media-src 'self' asset: http://asset.localhost — Phase 15 Plan
      //     02. The recording browser's <audio> elements resolve voice.wav
      //     via convertFileSrc(absPath) → asset://localhost/<path>.
      //     Without media-src, the browser engine silently refuses the
      //     load and the <audio> duration stays at "--:--" (RESEARCH
      //     Pitfall 1). http://asset.localhost is the http-scheme form
      //     emitted on Windows by WebView2.
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ws://127.0.0.1:8765 ipc: http://ipc.localhost; media-src 'self' asset: http://asset.localhost",
      // Phase 15 Plan 02 — assetProtocol exposes the recordings dir to the
      // webview via asset://localhost/<absolute-path> URLs. Scope locked
      // to BOTH $APPDATA and $APPLOCALDATA variants per RESEARCH Pitfall
      // 2: on macOS both resolve to ~/Library/Application Support/vibemix
      // (so one is a no-op); on Windows $APPDATA = Roaming and
      // $APPLOCALDATA = Local — listing both is the defensive pattern so
      // a future move of the recordings dir between roaming/local doesn't
      // silently break playback. NO new permission identifier — the
      // asset protocol is plugin-less in Tauri 2.
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/vibemix/recordings/**",
          "$APPLOCALDATA/vibemix/recordings/**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    // sidecar shipped as a resource directory (not externalBin) so PyInstaller's
    // --onedir _internal/ tree stays intact under Contents/Resources/.
    // sidecar.rs::spawn_sidecar_with_watchdog resolves the path via
    // app.path().resource_dir(). externalBin flattens onedir into MacOS/ which
    // breaks the PyInstaller bootloader (looks for libpython3.12.dylib in
    // Contents/Frameworks/ when .app detected).
    // Plan 27-06 / REC-09: ship BOTH arch-specific PyInstaller bundles so
    // Apple Silicon users on a fresh install never see the Rosetta prompt.
    // sidecar.rs picks the right one at runtime via std::env::consts::ARCH.
    // RESEARCH §Critical Correction: never lipo-merge the two bundles —
    // PyInstaller embeds its PKG archive in only the last merged slice.
    "resources": [
      "binaries/vibemix-core-aarch64-apple-darwin/**/*",
      "binaries/vibemix-core-x86_64-apple-darwin/**/*",
      "binaries/vibemix-core-x86_64-pc-windows-msvc/**/*",
      // Audit B-audio-firstrun: the wizard driver-fetch step shells the
      // companion scripts via wizard_cmds::companion_dir() =
      // resource_dir()/installer/companion. prepare_tauri_build.py mirrors
      // installer/companion/ here before bundling (resource globs cannot
      // reach ../ without path mangling).
      "installer/companion/**/*"
    ],
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "12.3",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "exceptionDomain": "",
      "providerShortName": null,
      // No frameworks bundled at the Tauri layer; PyInstaller ships everything inside the sidecar bundle.
      "frameworks": []
    }
  },
  "plugins": {
    "updater": {
      // Phase 18 Plan 18-04 — live updater config (replaces the Phase 11 STUB).
      //
      // No `active` key: that was Tauri v1 — in v2 the plugin is enabled by
      // being registered in main.rs (the check command capability is granted
      // via `updater:default` in capabilities/default.json).
      //
      // `endpoints` URL template — `{{target}}` becomes `darwin`/`windows`,
      // `{{arch}}` becomes `aarch64`/`x86_64`, `{{current_version}}` becomes
      // the running app's version. The server returns 204 No Content if the
      // running version is the latest; 200 with a Tauri static manifest
      // (`{ version, platforms: { "darwin-aarch64": ... } }`) if an update is
      // available. See docs/updater.md for the full contract.
      //
      // `pubkey` — base64-encoded minisign public key. Generated 2026-05-13
      // via `npx @tauri-apps/cli signer generate -w ~/.tauri/vibemix_updater.key`.
      // The matching private key is at ~/.tauri/vibemix_updater.key on Kaan's
      // Mac (NEVER commit). Before v0.1.0 tag: base64 the private half and
      // store as GitHub secret TAURI_UPDATER_PRIVATE_KEY (no password set).
      // Plan 18-05's release.yml gates on the literal placeholder sentinel
      // string in the pubkey VALUE — this comment no longer trips it.
      //
      // No `dialog` key: that was Tauri v1 — the v2 plugin has no built-in
      // prompt (its Config deserializer silently ignores unknown fields, so
      // the old `dialog: true` here changed nothing). Consent is asked in
      // src/updater.rs via tauri-plugin-dialog before any download; the
      // whole check is gated by `update_check_on_launch` (default true) in
      // tauri-plugin-store.
      //
      // Plan 40-05 — production key rotation
      // The pubkey above is the 2026-05-13 dev key (Phase 18-04). Production
      // rotation runbook lives in KAAN-ACTION-LEGAL.md §AUDIO-06. After
      // discharge: this line is replaced with the prod key armor and the
      // `gh secret set TAURI_UPDATER_PRIVATE_KEY` step uploads the private
      // half. The placeholder-pubkey-gate in release.yml fires for tagged
      // pushes ONLY (the dev key passes the gate today since it lacks the
      // TAURI_UPDATER_PLACEHOLDER sentinel — tests/tauri/test_updater_key_rotated.py
      // adds the dev-key-still-present gate that flips dual-mode on rotation).
      "endpoints": [
        "https://api.altidus.world/vibemix/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0QThGNkNFNDJFNjQ4N0QKUldSOVNPWkN6dmFvbEx4YjFuTmc3MUJ1MU9tdDVFRFRoUURYQW1qeWRkTC95a3FvSWV6QjBLNjEK"
    },
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
